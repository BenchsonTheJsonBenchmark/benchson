# Copy this file to ".env" and fill in the values:   cp .env.example .env
# ".env" is ignored by git - never commit it, never paste its content into chat.
# One KEY=VALUE per line. No spaces around "=" and no comment after a value.

WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=

# Only if your WatsonX region is not us-south (the default):
# WATSONX_URL=https://eu-de.ml.cloud.ibm.com/
